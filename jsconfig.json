{
  "compilerOptions": {
    "typeRoots": [
      "src/**/*.d.ts"
    ],
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
  },
  "include": [
    // Add all paths you want intellisense to work
    "src/**/*",
  ]
}
